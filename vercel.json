{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/sitemap.xml",
      "dest": "backend/main.py"
    },
    {
      "src": "/company",
      "headers": {
        "cache-control": "public, s-maxage=3600, stale-while-revalidate=86400"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
