~$*
*.tmp
~*.docx
~*.xlsx
~*.pptx

# Generated/exported documents (if you don't want to track them)
*.docx
*.pdf
*.xlsx

# Local-only report generator (builds Alpha_Move_AI_Technical_Review.docx)
build_tech_review.py

# Generated HTML edition of the user manual (built from USER_MANUAL.md by
# build_manual_html.py; an artifact, not a source — don't track it)
Alpha_Move_AI_User_Manual.html

# Manual screenshots — source images for the user manual, kept local only
# (they're embedded into Alpha_Move_AI_User_Manual.pdf by build_manual_html.py)
manual_assets/shots/

# Research blog image uploads — dev-default storage for backend/research.py's
# upload endpoint (prod uses RESEARCH_IMAGE_DIR on the Dokploy volume)
backend/research_images/

# Chart output from the on-demand analysis scripts in backend/analysis — the
# script is the source, the PNG is a re-runnable artifact of one day's data
backend/analysis/*.png
